<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>AdventureX - Trekking & Camping</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>
<header>
  <h2>🏔 AdventureX</h2>
  <nav><a href="#trips">Trips</a> <a href="#safety">Safety</a></nav>
</header>
<section class="hero">
  <h1>Explore Beyond Limits</h1>
  <p>Discover mountains, trails and unforgettable adventures.</p>
  <a href="#trips" class="btn">Explore Trips</a>
</section>
<section id="trips">
  <h2>Popular Adventures</h2>
  <div class="grid">
    <article class="card">
      <img src="https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?w=700" alt="Mountain trekking trail">
      <div class="info">
        <h3>Mountain Trek</h3>
        <p>Difficulty: Moderate</p>
        <p>Duration: 3 days</p>
        <p>Schedule: Every weekend</p>
        <h3>₹3,499 / person</h3>
      </div>
    </article>
    <article class="card">
      <img src="https://images.unsplash.com/photo-1478131143081-80f7f84ca84d?w=700" alt="Tent camping in nature">
      <div class="info">
        <h3>Forest Camping</h3>
        <p>Difficulty: Easy</p>
        <p>Duration: 2 days</p>
        <p>Schedule: Friday–Sunday</p>
        <h3>₹1,999 / person</h3>
      </div>
    </article>
    <article class="card">
      <img src="https://images.unsplash.com/photo-1464278533981-50106e6176b1?w=700" alt="Hiking in the mountains">
      <div class="info">
        <h3>Summit Expedition</h3>
        <p>Difficulty: Hard</p>
        <p>Duration: 5 days</p>
        <p>Schedule: Monthly batches</p>
        <h3>₹6,999 / person</h3>
      </div>
    </article>
  </div>
</section>
<section class="panels">
  <div class="panel">
    <h2>🎒 Equipment Checklist</h2>
    <label><input type="checkbox"> Hiking shoes</label>
    <label><input type="checkbox"> Backpack and water</label>
    <label><input type="checkbox"> First-aid kit</label>
    <label><input type="checkbox"> Torch and raincoat</label>
    <label><input type="checkbox"> Warm clothing</label>
  </div>
  <div class="panel" id="safety">
    <h2>⚠ Safety Guidelines</h2>
    <p>✓ Follow your trek leader.</p>
    <p>✓ Carry sufficient water.</p>
    <p>✓ Check weather conditions.</p>
    <p>✓ Stay on marked trails.</p>
    <p>✓ Carry emergency contacts.</p>
  </div>
</section>
<footer>© 2026 AdventureX | Explore Responsibly</footer>

</body>
</html>