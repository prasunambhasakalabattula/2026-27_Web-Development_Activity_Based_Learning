* { margin: 0; padding: 0; box-sizing: border-box; }
body {
  font-family: Arial, sans-serif;
  background: #f2f5ef;
  color: #263b2b;
}
header {
  background: #173d2a;
  color: white;
  padding: 20px 8%;
  display: flex;
  justify-content: space-between;
}
nav a { color: white; margin-left: 18px; text-decoration: none; }
.hero {
  padding: 100px 20px;
  text-align: center;
  color: white;
  background: linear-gradient(#0006, #0008),
    url("https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?w=1400") center/cover;
}
.hero h1 { font-size: 40px; margin-bottom: 15px; }
.hero p { margin-bottom: 25px; }
.btn {
  display: inline-block;
  padding: 12px 22px;
  background: #f4a261;
  color: #172b21;
  text-decoration: none;
  border-radius: 6px;
}
section:not(.hero) { padding: 40px 8%; }
h2 { margin-bottom: 22px; }

.grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
  gap: 22px;
}
.card {
  position: relative;
  height: 350px;
  overflow: hidden;
  border-radius: 12px;
  color: white;
}
.card img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.info {
  position: absolute;
  bottom: 0;
  width: 100%;
  padding: 22px;
  background: linear-gradient(transparent, #000e);
}
.info h3, .info p { margin-top: 10px; }
.panels {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: 20px;
}
.panel {
  background: white;
  padding: 25px;
  border-radius: 10px;
  border-left: 5px solid #47865b;
}
.panel label {
  display: block;
  margin: 15px 0;
}
footer {
  background: #173d2a;
  color: white;
  text-align: center;
  padding: 20px;
}
@media (max-width: 600px) {
  header { flex-direction: column; gap: 12px; }
  .hero h1 { font-size: 30px; }
  nav a { margin: 0 8px 0 0; }
}